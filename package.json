{
  "name": "tentwenty-test",
  "version": "1.0.0",
  "description": "This repo is created for the Technical assessment for TenTwenty job application for a SQA role.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:bdd": "bddgen && playwright test --project=bdd",
    "test:bdd:headed": "bddgen && playwright test --project=bdd --headed --workers=1",
    "test:tag:headed": "bddgen && playwright test --project=bdd --headed --workers=1 --grep"
  },
