  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "pdf-parse": "^2.4.5",
    "playwright-bdd": "^9.2.1",
    "typescript": "^7.0.2"
  }
}
